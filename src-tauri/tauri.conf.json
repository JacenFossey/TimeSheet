{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timesheet",
  "version": "2.0.1",
  "identifier": "com.keypak.timesheet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Timesheet",
        "url": "index.html",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#f3f6f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQTBDNzJDQTU3OEFFMzEKUldReHJuaWxMTWVnVGxMSjRaV3RJd2hCSkQyWXJNNU9IaEhFS0plM1dVaGNHY0xMRkwrQS85U3IK",
      "endpoints": [
        "https://github.com/JacenFossey/TimeSheet/releases/latest/download/latest.json"
      ]
    }
  }
}
